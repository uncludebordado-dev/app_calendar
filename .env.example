# ---------------------------------------------------------------------------
# Cliente (expuestas al browser) — solo claves PÚBLICAS de Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Solo servidor (NUNCA con prefijo NEXT_PUBLIC_, nunca en el cliente)
# ---------------------------------------------------------------------------
# Service role: solo se usa en route handlers / server actions para operaciones
# administrativas puntuales. Mantener en secreto.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Edge Function `send-booking-emails` (se configuran con `supabase secrets set`,
# no en Vercel). Se listan acá solo como referencia.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM="un clu de bordado <reservas@tudominio.com>"
# ADMIN_EMAIL=uncludebordado@gmail.com
# EMAIL_WEBHOOK_SECRET=un-secreto-largo-y-aleatorio
